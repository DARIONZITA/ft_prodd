# ===========================
# ENVIRONMENT
# ===========================
NODE_ENV=development

# ===========================
# DATABASE - PostgreSQL
# ===========================
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=transcendence_db

# ===========================
# CACHE - Redis
# ===========================
REDIS_PASSWORD=your_secure_password_here

# ===========================
# JWT & AUTHENTICATION
# ===========================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# OAUTH - 42 INTRA
# ===========================
# Get credentials from: https://profile.intra.42.fr/oauth/applications
INTRA_42_CLIENT_ID=your_42_client_id
INTRA_42_CLIENT_SECRET=your_42_client_secret
INTRA_42_CALLBACK_URL=http://localhost:3001/api/auth/42/callback

# ===========================
# OAUTH - GOOGLE (Optional)
# ===========================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ===========================
# OAUTH - GITHUB (Optional)
# ===========================
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ===========================
# FRONTEND ENVIRONMENT
# ===========================
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# ===========================
# CORS CONFIGURATION
# ===========================
CORS_ORIGIN=http://localhost:3000

# ===========================
# FILE UPLOAD
# ===========================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================
# LOGGING
# ===========================
LOG_LEVEL=debug

# ===========================
# SMTP (Optional - for email notifications)
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=noreply@transcendence.com
