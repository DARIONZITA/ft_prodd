generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum WorkspaceRole {
    admin
    member
    guest
    pending
    requesting
}

enum NotificationType {
    friendship
    workspace
    task
    mention
    taskAssignment
    taskUpdated
    taskDeleted
    workspaceInvite
    friendRequest
    friendRequestAccepted
    friendRequestRejected
    friendRemoved
    comment
    invite
}

enum FriendRequestStatus {
    pending
    accepted
}

enum Priority {
    LOW
    MEDIUM
    HIGH
}

enum ColumnType {
    backlog
    todo
    in_progress
    code_review
    done
    custom
}

enum LabelColor {
    red
    orange
    yellow
    green
    blue
    purple
    pink
    cyan
    teal
    indigo
    lime
    gray
    brown
}

model User {
    id           Int        @id @default(autoincrement())
    username     String     // @unique
    bio          String     @default("")
    email        String     @unique
    avatarUrl    String     @default("")
    apiKeyCount  Int        @default(0)
    fortyTwoId   Int?       @unique
    totalXp      Int        @default(0)
    passwordHash String
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    apiKeys                 ApiKey[]
    comments                Comment[]
    notifications           Notification[]
    taskAssignments         TaskAssignment[] @relation("assignee")
    assignedTasks           TaskAssignment[] @relation("assigner")
    tasksCreated            Task[]
    workspaceMemberships    WorkspaceMember[] @relation("MemberOf")
    invitedMemberships      WorkspaceMember[] @relation("InvitedBy")
    sentFriendRequests      FriendRequest[] @relation("sender")
    receivedFriendRequests  FriendRequest[] @relation("receiver")
}

model   ApiKey {
    id          Int      @id @default(autoincrement())
    keyHash     String   @unique
    name        String
    userId      Int
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
    id          Int      @id @default(autoincrement())
    name        String
    description String
    totalTask   Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    members       WorkspaceMember[]
    columns       Column[]
    labels        Label[]
}

model WorkspaceMember {
    id            Int           @id @default(autoincrement())
    workspaceId   Int
    userId        Int
    role          WorkspaceRole
    invitedRole   WorkspaceRole @default(member)
    invitedById   Int?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    user        User      @relation("MemberOf", fields: [userId], references: [id], onDelete: Cascade)
    invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

    @@unique([workspaceId, userId])
}

model Column {
    id          Int        @id @default(autoincrement())
    workspaceId Int
    name        String
    columnType  ColumnType @default(custom)
    order       Int
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    tasks Task[]
}

model Task {
    id            Int       @id @default(autoincrement())
    columnId      Int
    creatorId     Int
    title         String
    description   String
    priority      Priority  @default(MEDIUM)
    dueDate       DateTime?
    isDone        Boolean   @default(false)
    dateCompleted DateTime?
    orderInColumn Int
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    column  Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
    creator User   @relation(fields: [creatorId], references: [id])

    assignments    TaskAssignment[]
    checklistItems ChecklistItem[]
    comments       Comment[]
    taskLabels     TaskLabel[]
}

model TaskAssignment {
    id           Int      @id @default(autoincrement())
    taskId       Int
    userId       Int
    assignedById Int
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user       User @relation("assignee", fields: [userId], references: [id], onDelete: Cascade)
    assignedBy User @relation("assigner", fields: [assignedById], references: [id])

    @@unique([taskId, userId])
}

model ChecklistItem {
    id          Int      @id @default(autoincrement())
    taskId      Int
    description String
    isCompleted Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
    id                 Int              @id @default(autoincrement())
    userId             Int
    message            String
    type               NotificationType
    isRead             Boolean          @default(false)
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @updatedAt
 
    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
    id        Int      @id @default(autoincrement())
    taskId    Int
    authorId  Int
    content   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Label {
    id          Int        @id @default(autoincrement())
    workspaceId Int
    name        String
    color       LabelColor
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    taskLabels TaskLabel[]
}

model TaskLabel {
    id        Int      @id @default(autoincrement())
    taskId    Int
    labelId   Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
    label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

    @@unique([taskId, labelId])
}

model FriendRequest {
    id          Int @id @default(autoincrement())
    senderId    Int
    receiverId  Int
    status      FriendRequestStatus @default(pending)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    sender   User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
    receiver User @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

    @@unique([senderId, receiverId])
}
